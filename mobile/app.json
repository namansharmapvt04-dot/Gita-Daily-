{
  "expo": {
    "name": "Gita Daily",
    "slug": "gita-daily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0500",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0500"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gitadaily.app"
    },
    "android": {
      "package": "com.gitadaily.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0D0500"
      },
      "permissions": []
    },
    "plugins": ["expo-linear-gradient"]
  }
}
